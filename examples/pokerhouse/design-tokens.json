{
  "meta": {
    "project": "pokerhouse-client",
    "version": "0.1.0",
    "locale": "th-TH",
    "viewport": {
      "name": "iPhone 15 Pro Max",
      "width": 440,
      "height": 956,
      "dpr": 3
    }
  },

  "colors": {
    "bg": {
      "base": "#070707",
      "raised": "#111018",
      "elevated": "#15131D",
      "scrim": "rgba(0,0,0,0.6)"
    },
    "border": {
      "subtle": "#2A2832",
      "strong": "#3A3845"
    },
    "text": {
      "primary": "#F5F5F7",
      "secondary": "#848484",
      "muted": "#444444",
      "inverse": "#070707"
    },
    "accent": {
      "primary": "#25F95C",
      "primary_pressed": "#1FDA50",
      "warning": "#FBBF24",
      "danger": "#EF4444",
      "success": "#25F95C"
    }
  },

  "typography": {
    "fontFamily": {
      "display": "'Kanit', 'IBM Plex Sans Thai', sans-serif",
      "body": "'Sarabun', 'IBM Plex Sans Thai', sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "scale": {
      "display": { "size": 36, "weight": 700, "lineHeight": 1.2 },
      "title":   { "size": 20, "weight": 700, "lineHeight": 1.3 },
      "heading": { "size": 16, "weight": 700, "lineHeight": 1.4 },
      "body":    { "size": 15, "weight": 400, "lineHeight": 1.5 },
      "caption": { "size": 13, "weight": 400, "lineHeight": 1.4 },
      "micro":   { "size": 11, "weight": 400, "lineHeight": 1.3 }
    }
  },

  "radius": {
    "sm": 8,
    "md": 12,
    "card": 16,
    "pill": 20,
    "full": 9999
  },

  "spacing": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },

  "effects": {
    "shadow": {
      "card": "0 1px 0 rgba(255,255,255,0.04) inset",
      "popover": "0 8px 24px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.06) inset"
    },
    "glow": {
      "accent": "0 0 32px rgba(37,249,92,0.28)",
      "accent_strong": "0 0 48px rgba(37,249,92,0.45)"
    }
  },

  "motion": {
    "duration": { "fast": 120, "default": 200, "slow": 320 },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)"
    }
  },

  "components": {
    "button": {
      "primary": {
        "minHeight": 48,
        "paddingX": 24,
        "paddingY": 12,
        "radius": "pill",
        "bg": "accent.primary",
        "text": "text.inverse",
        "fontWeight": 700,
        "fontSize": "body.size"
      },
      "secondary": {
        "minHeight": 48,
        "paddingX": 24,
        "paddingY": 12,
        "radius": "pill",
        "bg": "bg.raised",
        "border": "border.subtle",
        "text": "text.primary",
        "fontWeight": 700,
        "fontSize": "body.size"
      }
    },
    "card": {
      "default": {
        "bg": "bg.raised",
        "border": "border.subtle",
        "radius": "card",
        "padding": 20
      }
    },
    "input": {
      "default": {
        "minHeight": 56,
        "paddingX": 16,
        "paddingY": 16,
        "radius": "md",
        "bg": "bg.raised",
        "border": "border.subtle",
        "text": "text.primary",
        "placeholder": "text.secondary"
      }
    }
  }
}
